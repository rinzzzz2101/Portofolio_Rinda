generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  thumbnail    String?  @db.Text
  description  String   @db.Text
  technologies String   @db.Text
  githubUrl    String?
  demoUrl      String?
  category     String
  isFeatured   Boolean  @default(false)
  status       String   @default("Completed")
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Skill {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  level     Int      @default(0)
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String    @id @default(uuid())
  position    String
  company     String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String    @db.Text
  companyLogo String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Education {
  id           String    @id @default(uuid())
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  description  String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Organization {
  id          String    @id @default(uuid())
  name        String
  role        String
  startDate   DateTime
  endDate     DateTime?
  description String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Certificate {
  id        String   @id @default(uuid())
  name      String
  issuer    String
  pdfUrl    String?
  thumbnail String?
  issueDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id          String   @id @default(uuid())
  nameTitle   String?  // Optional placeholder
  title       String
  slug        String   @unique
  content     String   @db.Text
  thumbnail   String?
  tags        String?  @db.Text
  category    String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProfileView {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model Setting {
  id           String   @id @default("singleton")
  siteTitle    String   @default("Portfolio.")
  faviconUrl   String?  @db.Text
  name         String   @default("")
  role         String   @default("")
  hireStatus   String   @default("")
  description  String   @db.Text
  about        String   @db.Text
  email        String   @default("")
  phone        String   @default("")
  location     String   @default("")
  github       String   @default("")
  linkedin     String   @default("")
  instagram    String   @default("")
  twitter      String   @default("")
  cvUrl        String   @db.Text
  cvFileName   String   @default("")
  cvActive            Boolean  @default(true)
  socialActive        Boolean  @default(true)
  overviewActive      Boolean  @default(true)
  projectsActive      Boolean  @default(true)
  skillsActive        Boolean  @default(true)
  experienceActive    Boolean  @default(true)
  educationActive     Boolean  @default(true)
  organizationsActive Boolean  @default(true)
  certificatesActive  Boolean  @default(true)
  blogsActive         Boolean  @default(true)
  messagesActive      Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpToken {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
